<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SelfCheckoutApp.Pages.StoreSelectionPage"
    Title="Select Store">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Select a Store" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <!-- CollectionView with a Button for each store -->
        <CollectionView x:Name="StoresCollectionView" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding StoreName}"
                            Clicked="OnStoreButtonClicked"
                            CommandParameter="{Binding}"
                            FontSize="20"
                            HorizontalOptions="FillAndExpand"
                            BackgroundColor="LightGray"
                            TextColor="Black"
                            Margin="5"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
