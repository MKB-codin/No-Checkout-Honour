<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SelfCheckoutApp.Pages.ReceiptsPage"
    Title="Past Receipts">
    <VerticalStackLayout Padding="20" Spacing="10">
        <CollectionView x:Name="ReceiptsCollectionView"
                        ItemsSource="{Binding Receipts}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="5" >
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReceiptTapped"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <StackLayout>
                            <Label Text="{Binding StoreName}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding PurchaseDate, StringFormat='Purchased on: {0:dd MMM yyyy HH:mm}'}" FontSize="14" />
                            <Label Text="{Binding Total, StringFormat='Total: £{0:F2}'}" FontSize="14" />
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
