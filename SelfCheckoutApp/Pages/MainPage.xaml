<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SelfCheckoutApp.Pages.MainPage"
             Title="Main Page">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="True" Command="{Binding LogoutCommand}" />
    </Shell.BackButtonBehavior>

    <VerticalStackLayout Padding="20" Spacing="30" VerticalOptions="StartAndExpand">
        <!-- Start Shopping Button -->
        <Button Text="Start Shopping"
                Clicked="OnStartShoppingClicked"
                HorizontalOptions="FillAndExpand"
                FontSize="18" />

        <!-- Receipts Button -->
        <Button Text="Receipts"
                Clicked="OnReceiptsClicked"
                HorizontalOptions="FillAndExpand"
                FontSize="18" />
    </VerticalStackLayout>
</ContentPage>
