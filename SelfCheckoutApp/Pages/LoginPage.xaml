<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SelfCheckoutApp.Pages.LoginPage"
             Title="Login">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="StartAndExpand">
        <!-- Welcome Label -->
        <Label Text="Welcome to NoCheckout" 
               FontSize="32" 
               HorizontalOptions="Center" />

        <!-- Server Status Message -->
        <Label x:Name="ServerStatusMessage"
               Text="Server is offline. Please try again later."
               TextColor="Red"
               IsVisible="False"
               HorizontalOptions="Center" />

        <!-- Email Entry -->
        <Entry x:Name="EmailEntry" 
               Placeholder="Email" 
               Keyboard="Email" />

        <!-- Password Entry -->
        <Entry x:Name="PasswordEntry" 
               Placeholder="Password" 
               IsPassword="True" />

        <!-- Login Button -->
        <Button x:Name="LoginButton"
                Text="Log In" 
                Clicked="OnLoginClicked" 
                HorizontalOptions="Fill" />

        <!-- Error Message -->
        <Label x:Name="ErrorMessage" 
               TextColor="Red" 
               IsVisible="False" 
               HorizontalOptions="Center" />

        <!-- Or Section -->
        <Grid ColumnDefinitions="*,Auto,*" VerticalOptions="Center" HorizontalOptions="Fill">
            <BoxView Grid.Column="0" HeightRequest="1" Color="Gray" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="  or  " FontSize="16" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
            <BoxView Grid.Column="2" HeightRequest="1" Color="Gray" VerticalOptions="Center" />
        </Grid>

        <!-- Sign Up Button -->
        <Button Text="Sign Up" 
                Clicked="OnSignUpClicked" 
                HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>
