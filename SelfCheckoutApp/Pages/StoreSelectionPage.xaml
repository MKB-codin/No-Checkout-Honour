<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SelfCheckoutApp.Pages.StoreSelectionPage"
             Title="Select Store">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Select a Store"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- CollectionView for Stores -->
        <CollectionView x:Name="StoresCollectionView"
                        SelectionMode="None">
            <!-- Remove SelectionMode -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10"
                           Margin="5"
                           BackgroundColor="LightGray"
                           HasShadow="True">
                        <Label Text="{Binding StoreName}"
                               FontSize="20"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

                        <!-- Tap Gesture -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="{Binding}" />
                        </Frame.GestureRecognizers>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
